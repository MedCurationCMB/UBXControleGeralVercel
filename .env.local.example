# Copie para .env.local e preencha. NUNCA coloque valores reais neste arquivo (o repositorio e publico).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT Secret (Project Settings > API > JWT Keys). Usado para assinar o token do usuario que o RLS le.
SUPABASE_JWT_SECRET=

# Backblaze B2
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Google Gemini (fallback; a chave vigente fica na tabela assistente_virtual)
GEMINI_API_KEY=

# Session (gere uma string aleatoria segura de 32+ chars)
SESSION_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
